{
     "compilerOptions": {
          "rootDir": "./src",
          "outDir": "./dist",
          "module": "NodeNext",
          "moduleResolution": "NodeNext",
          "target": "ES2022",
          "lib": [
               "ES2022",
               "DOM",
               "DOM.Iterable"
          ],
          "strict": true,
          "declaration": true,
          "noEmitOnError": true,
          "verbatimModuleSyntax": true,
          "isolatedModules": true,
          "skipLibCheck": true,
          "noUncheckedIndexedAccess": true,
          "exactOptionalPropertyTypes": true,
          "noUnusedLocals": true,
          "noUnusedParameters": true,
          "noFallthroughCasesInSwitch": true
     },
     "include": [
          "src/**/*.ts"
     ]
}
